NODE_ENV=development
PORT=5050
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flightiq
DB_SSL=false
# Leave blank to auto-detect the workspace .venv; otherwise provide python/python3 or an absolute path.
PYTHON_COMMAND=
PREDICTION_TIMEOUT_MS=10000
ALLOW_PREDICTION_FALLBACK=true
